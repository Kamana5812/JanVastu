APP_ENV=demo
# Use owner credentials only for migrations and provisioning:
# DATABASE_URL=postgresql+psycopg2://janvastu:janvastu_pass@localhost:5432/janvastu
DATABASE_URL=postgresql+psycopg2://janvastu_api:local-demo-runtime-password@localhost:5432/janvastu
RUNTIME_DB_PASSWORD=local-demo-runtime-password
SECRET_KEY=development-only-change-this-secret-before-deployment
MOCK_OTP_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=janvastu-media
MINIO_SECURE=false
GOOGLE_CLIENT_ID=
